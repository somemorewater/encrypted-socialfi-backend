{
  "name": "encrypted-socialfi-backend",
  "version": "0.1.0",
  "description": "Privacy-preserving SocialFi backend: end-to-end encrypted content + zero-knowledge (Schnorr) authentication.",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "demo": "node scripts/demo.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "cors": "2.8.5",
    "express": "5.1.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.16.3",
    "zod": "3.25.76"
  }
}
